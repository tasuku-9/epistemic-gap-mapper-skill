{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Epistemic Gap Mapper Edge",
  "type": "object",
  "required": ["from", "to", "relation"],
  "properties": {
    "from": {"type": "string"},
    "to": {"type": "string"},
    "relation": {
      "type": "string",
      "enum": [
        "supports",
        "supports_weakly",
        "contradicts",
        "extends",
        "qualifies",
        "depends_on",
        "explains_gap",
        "challenges_narrative",
        "overclaims",
        "requires_test",
        "falsified_by",
        "heuristic_analogy_for",
        "not_direct_evidence"
      ]
    },
    "reason": {"type": "string"},
    "confidence": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
    "support_strength": {
      "type": "string",
      "enum": [
        "direct",
        "hedged",
        "presupposed",
        "contextual",
        "counter_example",
        "analogy_only",
        "no_direct_support",
        "unknown"
      ]
    },
    "support_mode": {
      "type": "string",
      "enum": [
        "empirical",
        "textual",
        "inferential",
        "methodological",
        "comparative",
        "narrative_trace"
      ]
    },
    "source_span": {"type": "string"},
    "local_check_status": {"type": "string", "enum": ["pass", "warn", "fail", "needs_source"]},
    "claim_scope_match": {"type": "string", "enum": ["full", "partial", "mismatch", "unknown"]},
    "vocabulary_match": {"type": "string", "enum": ["same_terms", "mapped_terms", "ambiguous", "mismatch"]},
    "granularity_match": {"type": "string", "enum": ["same_grain", "too_broad", "too_narrow", "atomized", "unknown"]}
  },
  "additionalProperties": false
}
