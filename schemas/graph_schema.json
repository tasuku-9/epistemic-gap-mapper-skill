{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Epistemic Gap Mapper Graph",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {"$ref": "node_schema.json"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "edge_schema.json"}
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
