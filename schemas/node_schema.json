{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Epistemic Gap Mapper Node",
  "type": "object",
  "required": ["node_id", "node_type", "text"],
  "properties": {
    "node_id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "node_type": {
      "type": "string",
      "enum": [
        "PaperNode",
        "SourceClaimNode",
        "UserClaimNode",
        "EvidenceNode",
        "InferenceNode",
        "AssumptionNode",
        "NarrativeNode",
        "NarrativeTraceNode",
        "GapNode",
        "ExceptionNode",
        "RiskNode",
        "FalsifierNode",
        "MethodNode"
      ]
    },
    "text": {"type": "string", "pattern": "\\S"},
    "citation": {"type": "string"},
    "tier": {"type": "string", "enum": ["A", "B", "C", "X", "M", "unknown"]},
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "evidence_laundering",
          "analogy_inflation",
          "narrative_capture",
          "falsifier_removal",
          "citation_debt",
          "scope_jump"
        ]
      }
    },
    "failure_mode_notes": {"type": "string"},
    "vocabulary_map": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "definition_scope": {"type": "string"},
    "granularity_justification": {"type": "string"},
    "proposed_tier": {"type": "string", "enum": ["A", "B", "C", "X", "M"]},
    "declared_tier": {"type": "string", "enum": ["A", "B", "C", "X", "M"]},
    "tier_declared_by": {"type": "string"},
    "tier_declaration_ref": {"type": "string"},
    "tier_rationale": {"type": "string"},
    "tier_review_status": {
      "type": "string",
      "enum": ["proposed", "declared", "reviewer_checked", "needs_review", "disputed", "unknown"]
    },
    "domain": {"type": "string"},
    "source_kind": {"type": "string"},
    "role": {"type": "string"},
    "verification_status": {"type": "string"},
    "source_paper": {"type": "string"},
    "source": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      ]
    },
    "source_status": {"type": "string"},
    "citation_debt": {"type": "string", "enum": ["low", "medium", "high", "unknown", "not_applicable"]},
    "component_claims": {"type": "array", "items": {"type": "string"}},
    "supporting_sources": {"type": "array", "items": {"type": "string"}},
    "related_target_papers": {"type": "array", "items": {"type": "string"}},
    "related_target_narratives": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "falsifiers": {"type": "array", "items": {"type": "string"}},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "risk_level": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
    "located_in": {"type": "array", "items": {"type": "string"}},
    "importance": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
    "target_narrative": {"type": "string"},
    "trace_status": {
      "type": "string",
      "enum": [
        "direct_support",
        "partial_support",
        "compatible_context",
        "not_direct_claim",
        "no_source_identified",
        "unknown"
      ]
    },
    "citation_debt_effect": {
      "type": "string",
      "enum": ["lowers", "raises", "clarifies", "unchanged", "unknown"]
    },
    "risky_phrase": {"type": "string"},
    "why_risky": {"type": "string"},
    "suggested_patch": {"type": "string"},
    "would_weaken": {"type": "array", "items": {"type": "string"}},
    "required_evidence": {"type": "string"},
    "test_plan": {
      "type": "object",
      "required": ["measurement", "weakening_result", "alternative_explanation"],
      "properties": {
        "measurement": {"type": "string", "pattern": "\\S"},
        "weakening_result": {"type": "string", "pattern": "\\S"},
        "alternative_explanation": {"type": "string", "pattern": "\\S"}
      },
      "additionalProperties": false
    },
    "method_name": {"type": "string"},
    "not_evidence": {"type": "boolean"},
    "confidence": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"node_type": {"const": "PaperNode"}}},
      "then": {"required": ["citation", "domain", "source_kind", "role", "verification_status"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "SourceClaimNode"}}},
      "then": {"required": ["source_paper", "domain", "confidence"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "UserClaimNode"}}},
      "then": {"required": ["tier", "domain", "supporting_sources", "related_target_papers", "related_target_narratives", "risks", "falsifiers"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "EvidenceNode"}}},
      "then": {"required": ["source", "domain", "tier"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "InferenceNode"}}},
      "then": {"required": ["tier", "depends_on", "risks"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "AssumptionNode"}}},
      "then": {"required": ["tier", "risk_level"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "NarrativeNode"}}},
      "then": {"required": ["source_status", "citation_debt", "component_claims"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "NarrativeTraceNode"}}},
      "then": {"required": ["target_narrative", "source_paper", "trace_status", "citation_debt_effect"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "GapNode"}}},
      "then": {"required": ["located_in", "importance"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "ExceptionNode"}}},
      "then": {"required": ["target_narrative", "source"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "RiskNode"}}},
      "then": {"required": ["risky_phrase", "why_risky", "suggested_patch"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "FalsifierNode"}}},
      "then": {"required": ["would_weaken", "required_evidence"]}
    },
    {
      "if": {"properties": {"node_type": {"const": "MethodNode"}}},
      "then": {"required": ["method_name", "not_evidence"], "properties": {"not_evidence": {"const": true}}}
    },
    {
      "if": {"required": ["declared_tier"]},
      "then": {
        "required": ["tier_declared_by", "tier_declaration_ref", "tier_rationale", "tier_review_status"],
        "properties": {"tier_review_status": {"enum": ["declared", "reviewer_checked", "disputed"]}}
      }
    },
    {
      "if": {"required": ["tier_review_status"], "properties": {"tier_review_status": {"enum": ["declared", "reviewer_checked", "disputed"]}}},
      "then": {"required": ["declared_tier"]}
    },
    {
      "if": {"anyOf": [{"required": ["tier_declared_by"]}, {"required": ["tier_declaration_ref"]}]},
      "then": {"required": ["declared_tier"]}
    },
    {
      "if": {"required": ["tier"], "properties": {"tier": {"const": "X"}}},
      "then": {"required": ["failure_modes"]}
    },
    {
      "if": {"required": ["declared_tier"], "properties": {"declared_tier": {"const": "X"}}},
      "then": {"required": ["failure_modes"]}
    },
    {
      "if": {"required": ["proposed_tier"], "properties": {"proposed_tier": {"const": "X"}}},
      "then": {"required": ["failure_modes"]}
    }
  ],
  "additionalProperties": true
}
